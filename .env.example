# ---------------------------------------------------------------------------
# CAIP environment variables — all OPTIONAL.
# The app runs fully without any of these (live weather works with no key;
# NDVI and IoT fall back to sample/seed data). Copy to `.env.local` to enable.
# ---------------------------------------------------------------------------

# Live NDVI via Sentinel Hub (free account: https://www.sentinel-hub.com).
# Create an OAuth client under User Settings, then paste id/secret here.
# Without these, /api/ndvi returns a simulated series.
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=

# Protect the IoT ingestion endpoint (POST /api/iot).
# When set, incoming readings must include header:  x-ingest-key: <this value>
INGEST_API_KEY=
